[Unit]
Description=Backup Ricetta PostgreSQL database to S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/ricetta
ExecStart=/usr/local/bin/ricetta-postgres-backup.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
